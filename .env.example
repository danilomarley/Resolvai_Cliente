# Existing Supabase session client (public configuration only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-key

# Development: Vite forwards /api to the official API.
API_PROXY_TARGET=http://localhost:5172

# Production: empty uses a reverse proxy on the same origin.
# A separate origin requires backend CORS configuration.
VITE_API_BASE_URL=
