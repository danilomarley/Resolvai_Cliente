# Desenvolvimento: o Vite encaminha /api para a API (Resolvai_Backend_Node, porta padrão 5172).
API_PROXY_TARGET=http://localhost:5172

# Produção: URL da API (ex.: https://resolvai-api.onrender.com). Lida no build.
# Vazio usa um proxy reverso na mesma origem. Uma API em outra origem exige CORS_ALLOWED_ORIGINS na API.
VITE_API_BASE_URL=
